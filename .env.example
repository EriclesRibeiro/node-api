# Conexão com o MongoDB (obrigatório)
MONGO_URI=

# Segredo para assinatura dos tokens JWT (obrigatório, mínimo de 32 caracteres)
SECRET=

# Porta do servidor (PORT ou LOCAL_PORT, obrigatório)
PORT=3000
LOCAL_PORT=

# Credenciais do usuário administrador criado no populate (obrigatório)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origens permitidas pelo CORS (opcional). Sem valor, apenas localhost é aceita.
# Ex.: CORS_ORIGINS=http://localhost:3001,https://app.example.com
CORS_ORIGINS=

# Confiança em proxy reverso (opcional). Defina apenas se estiver atrás de um
# proxy (ex.: TRUST_PROXY=1 ou TRUST_PROXY=loopback) para o rate limit e o CORS
# identificarem o IP real do cliente.
TRUST_PROXY=