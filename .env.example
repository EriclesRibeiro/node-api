# Conexão com o MongoDB (obrigatório)
MONGO_URI=

# Segredo para assinatura dos tokens JWT (obrigatório)
SECRET=

# Porta do servidor (PORT ou LOCAL_PORT, obrigatório)
PORT=3000
LOCAL_PORT=

# Credenciais do usuário administrador criado no populate (obrigatório)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origens permitidas pelo CORS (opcional). Sem valor, qualquer origem é refletida.
# Ex.: CORS_ORIGINS=http://localhost:3001,https://app.example.com
CORS_ORIGINS=